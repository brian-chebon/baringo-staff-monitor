/android/app/release

# Generated localization output (regenerated with `flutter gen-l10n`)
lib/l10n/generated/

# =============================================================================
# Firebase config — embedded in client builds but conventionally gitignored.
# Each developer regenerates locally with `flutterfire configure`.
# =============================================================================
.firebaserc
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
.runtimeconfig.json

# Generated by FlutterFire CLI — contains per-project Firebase web/Android/iOS keys
lib/firebase_options.dart

# Android / iOS / macOS Firebase service files
android/app/google-services.json
android/app/src/*/google-services.json
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json
macos/Runner/GoogleService-Info.plist
macos/firebase_app_id_file.json

# =============================================================================
# Android signing keys
# =============================================================================
**/*.keystore
**/*.jks
**/*.p12
**/*.pfx
android/key.properties
android/app/upload-keystore.jks

# =============================================================================
# iOS signing
# =============================================================================
ios/Runner/GoogleService-Info.plist
*.mobileprovision
*.cer
*.certSigningRequest

